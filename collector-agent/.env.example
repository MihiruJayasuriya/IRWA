# Copy this file to .env and edit it. NEVER commit .env.
# Generate a strong key with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# ---- Security ----------------------------------------------------------
# Shared secret. Same variable name as the Router's .env, so the whole
# system can use one key (inbound calls to the collector AND its calls to the Router).
INTERNAL_API_KEY=change-me-to-a-long-random-string
# Optional overrides:
# COLLECTOR_API_KEY=      # collector-only inbound key (takes priority over INTERNAL_API_KEY)
# ROUTER_API_KEY=         # key the collector sends TO the router (defaults to INTERNAL_API_KEY)

# ---- Autonomous agent --------------------------------------------------
ROUTER_URL=http://localhost:8000
COLLECTOR_AGENT_ENABLED=true      # false = passive API only (no background loop)
COLLECTOR_POLL_SECONDS=2          # normal sampling interval
COLLECTOR_HEIGHTENED_FACTOR=0.5   # while a zone is in alert, poll every (interval x factor)
ROUTER_TIMEOUT=5
EVIDENCE_MIN_SCORE=0.15           # ignore weak IR matches when citing SOP documents

# ---- Rule thresholds (defaults come from the SOP documents in ir-module/) ----
# LEAK_RATIO_THRESHOLD=1.40       # leak_detection_procedure.txt: >40% above 7-day average
# LEAK_WINDOW=7
# LEAK_MAJOR_LITERS=5000          # minor < 5000 L/day <= major
# LEAK_CONFIRM_HITS=2             # collector assumption: hits needed within the window to "confirm"
# LEAK_CONFIRM_WINDOW=3
# DROUGHT_HYSTERESIS_PCT=2        # margin above a threshold needed to step DOWN a drought stage
# RESERVOIR_JUMP_PCT=25           # implausible one-step reservoir change
# STUCK_SENSOR_WINDOW=10
# STUCK_SENSOR_RANGE=0.5
