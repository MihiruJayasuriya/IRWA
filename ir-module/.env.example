# Copy this file to .env and edit it. NEVER commit .env.
# Generate a strong key with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# Shared secret: same variable name as the Router / Collector, so one key works for the whole system.
INTERNAL_API_KEY=change-me-to-a-long-random-string
# IR_API_KEY=            # optional: IR-only key (takes priority over INTERNAL_API_KEY)

# ---- Retrieval settings (defaults are fine; see evaluation_results.md and eval/tune.py) ----
# IR_BM25_K1=1.5
# IR_BM25_B=0.75
# IR_PASSAGE_SENTENCES=2     # sentences per passage
# IR_EXPANSION_WEIGHT=1.0    # weight of thesaurus terms relative to the user's own words
# IR_TITLE_WEIGHT=2
# IR_IDF_LEVEL=document      # or: passage
# IR_MIN_BM25=1.0            # evidence needed before a match is returned (abstention)
# IR_REL_CUTOFF=0.3          # drop results scoring under 30% of the best result
